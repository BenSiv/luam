{
    "name": "Luam",
    "scopeName": "source.luam",
    "fileTypes": [
        "lua"
    ],
    "patterns": [
        {
            "name": "comment.line.double-dash.luam",
            "match": "--.*$"
        },
        {
            "name": "string.quoted.triple.luam",
            "begin": "\"\"\"",
            "end": "\"\"\"",
            "patterns": [
                {
                    "name": "constant.character.escape.luam",
                    "match": "\\\\([abfnrtvz\\\\\"']|0(?![0-9])|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
                }
            ]
        },
        {
            "name": "string.quoted.double.luam",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.luam",
                    "match": "\\\\([abfnrtvz\\\\\"']|0(?![0-9])|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
                }
            ]
        },
        {
            "name": "keyword.control.luam",
            "match": "\\b(break|do|else|elseif|end|for|if|in|return|then|while)\\b"
        },
        {
            "name": "keyword.operator.logical.luam",
            "match": "\\b(and|or|not)\\b"
        },
        {
            "name": "storage.type.luam",
            "match": "\\b(function|const)\\b"
        },
        {
            "name": "constant.language.luam",
            "match": "\\b(true|false|nil)\\b"
        },
        {
            "name": "variable.language.self.luam",
            "match": "\\b(self|_G|_VERSION)\\b"
        },
        {
            "name": "support.function.library.luam",
            "match": "\\b(assert|collectgarbage|dofile|error|getfenv|getmetatable|ipairs|load|loadfile|loadstring|module|next|pairs|pcall|print|rawequal|rawget|rawset|require|select|setfenv|setmetatable|tonumber|tostring|type|unpack|xpcall)\\b"
        },
        {
            "name": "keyword.operator.luam",
            "match": "!=|==|<=|>=|<|>|=|\\.\\.\\.|\\.\\.|\\.|\\+|\\-|\\*|/|%|\\^|#"
        },
        {
            "name": "constant.numeric.luam",
            "match": "\\b0[xX][0-9a-fA-F]+\\b|\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
    ]
}